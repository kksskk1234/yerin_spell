# Copy this file to ".env.local" and fill in your key.
# .env.local is gitignored, so your key is never committed.

# Anthropic API key — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model. Defaults to claude-haiku-4-5 (cheapest, good enough here).
# Use claude-opus-4-8 for maximum accuracy on hard-to-read images.
# ANTHROPIC_MODEL=claude-opus-4-8
